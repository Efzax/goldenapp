// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  USER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String? 
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  stores UserStore[]
}

model Store {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  externalCode String? @unique
  chainId   String
  createdAt DateTime @default(now())

  chain     Chain @relation(fields: [chainId], references: [id])
  users       UserStore[]
  inventories Inventory[]
}

model UserStore {
  id      String @id @default(uuid())
  userId  String
  storeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, storeId])
}

model ProductFamily {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

enum Category {
  TV
  AV
}

model Product {
  id        String   @id @default(uuid())
  sku       String   @unique
  name      String
  familyId  String
  family    ProductFamily   @relation(fields: [familyId], references: [id])

 category  Category @default(TV)   // 👈 con default

  createdAt DateTime @default(now())
  inventory Inventory[]
}


model Inventory {
  id        String @id @default(uuid())
  storeId   String
  productId String

  stock    Int
  exhib    Boolean @default(false)
  minStock Int

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([storeId, productId])
}

model Chain {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  stores    Store[]
}